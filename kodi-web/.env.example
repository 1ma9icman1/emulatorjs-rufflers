# RomM is already provided by the parent Docker stack on port 8080.
VITE_ROMM_URL=http://localhost:8080

# Optional: Jellyfin server URL for movie and TV playback.
VITE_JELLYFIN_URL=

# Optional: TVHeadend or another legal IPTV gateway URL.
VITE_TV_URL=

# VLC bridge and a local media file or legal stream to test video playback.
VITE_VLC_URL=http://127.0.0.1:8090
VITE_FEATURED_VIDEO=
